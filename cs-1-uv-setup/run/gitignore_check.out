## cat .gitignore
# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
## git status --short
?? .gitignore
?? .python-version
?? README.md
?? pyproject.toml
?? src/
?? uv.lock
## git check-ignore -v uv.lock .venv  (prints only ignored paths)
.gitignore:10:.venv	.venv
exit: 0
## git status --short --ignored after uv run pytest
?? .gitignore
?? .python-version
?? README.md
?? pyproject.toml
?? src/
?? uv.lock
!! .pytest_cache/
!! .venv/
!! src/inventory_tool/__pycache__/
## git check-ignore -v .pytest_cache .venv src/inventory_tool/__pycache__
.gitignore:10:.venv	.venv
.gitignore:2:__pycache__/	src/inventory_tool/__pycache__
